<style>
:root{--bg:#f7f5f2;--card:#fff;--ink:#171717;--muted:#777;--line:#e8e4df;--accent:#111;--sale:#b12b2b}
*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}
body{font-family:Cairo,Arial,sans-serif;background:var(--bg);color:var(--ink)}
a{text-decoration:none;color:inherit}.container{width:min(1180px,92%);margin:auto}
.topbar{background:#111;color:#fff;text-align:center;padding:9px;font-size:13px;letter-spacing:.3px}
header{background:rgba(247,245,242,.92);backdrop-filter:blur(12px);position:sticky;top:0;z-index:20;border-bottom:1px solid var(--line)}
.nav{height:78px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.logo{font-family:Montserrat,sans-serif;font-size:25px;font-weight:800;letter-spacing:2px}
.logo span{font-size:11px;display:block;letter-spacing:4px;color:#777;text-align:center;margin-top:-3px}
nav{display:flex;gap:28px;font-size:14px}nav a:hover{opacity:.55}
.actions{display:flex;gap:10px;align-items:center}.icon{width:42px;height:42px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;background:#fff;cursor:pointer}
.hero{min-height:610px;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;padding:55px 0}
.hero-copy small{letter-spacing:3px;color:#777;font-family:Montserrat}.hero h1{font-size:clamp(44px,6vw,78px);line-height:1.02;margin:17px 0;font-weight:800}.hero h1 em{font-style:normal;font-weight:400}.hero p{color:var(--muted);max-width:500px;line-height:1.9;margin-bottom:28px}
.btn{display:inline-flex;align-items:center;justify-content:center;padding:14px 25px;border-radius:4px;background:#111;color:#fff;font-weight:700;font-size:14px;transition:.25s}.btn:hover{transform:translateY(-2px);background:#333}.btn.light{background:#fff;color:#111;border:1px solid var(--line);margin-right:8px}
.hero-img{height:520px;border-radius:10px;overflow:hidden;position:relative;background:#ddd}.hero-img img{width:100%;height:100%;object-fit:cover}.hero-badge{position:absolute;bottom:22px;right:22px;background:#fff;padding:14px 18px;font-weight:700;border-radius:4px}
.section{padding:75px 0}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:30px}.eyebrow{font-family:Montserrat;letter-spacing:2px;font-size:11px;color:#888}.section h2{font-size:34px;margin-top:5px}.link{font-size:13px;text-decoration:underline}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.product{background:var(--card);position:relative}.product-img{height:330px;overflow:hidden;background:#eee;position:relative}.product-img img{width:100%;height:100%;object-fit:cover;transition:.5s}.product:hover img{transform:scale(1.04)}.tag{position:absolute;top:12px;right:12px;background:#fff;padding:5px 9px;font-size:11px}.tag.sale{color:var(--sale)}
.info{padding:15px 3px}.info h3{font-size:15px;margin-bottom:7px}.meta{display:flex;justify-content:space-between;color:#777;font-size:13px}.price{color:#111;font-weight:700}.old{text-decoration:line-through;color:#aaa;font-weight:400;margin-left:5px}
.banner{margin:25px 0;background:#181818;color:#fff;min-height:340px;display:grid;grid-template-columns:1fr 1fr;align-items:center;overflow:hidden}.banner-copy{padding:45px}.banner h2{font-size:42px;line-height:1.2;margin:10px 0 18px}.banner p{color:#bbb;line-height:1.8;margin-bottom:25px}.banner-img{height:100%;min-height:340px}.banner-img img{width:100%;height:100%;object-fit:cover}
.categories{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.cat{height:270px;position:relative;overflow:hidden;color:#fff}.cat img{width:100%;height:100%;object-fit:cover;filter:brightness(.68);transition:.5s}.cat:hover img{transform:scale(1.06);filter:brightness(.55)}.cat div{position:absolute;inset:auto 22px 20px}.cat h3{font-size:25px}
.newsletter{background:#eae6e0;padding:55px;text-align:center}.newsletter h2{font-size:30px}.newsletter p{color:#777;margin:8px 0 22px}.form{display:flex;max-width:500px;margin:auto}.form input{flex:1;border:1px solid #d8d2ca;padding:14px;background:#fff;font-family:inherit}.form button{border:0;background:#111;color:#fff;padding:0 25px;font-family:inherit;font-weight:700}
footer{background:#111;color:#fff;padding:55px 0 20px;margin-top:60px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:35px}.footer-logo{font-family:Montserrat;font-size:25px;font-weight:800;letter-spacing:2px}.footer p,.footer a{color:#aaa;font-size:13px;line-height:2}.footer h4{margin-bottom:13px}.copy{border-top:1px solid #292929;margin-top:35px;padding-top:18px;color:#777;font-size:12px}
.cart{position:fixed;left:20px;bottom:20px;background:#111;color:#fff;border-radius:50px;padding:13px 18px;z-index:30;box-shadow:0 8px 25px #0002;font-size:13px}
@media(max-width:850px){nav{display:none}.hero{grid-template-columns:1fr;padding-top:35px}.hero-img{height:430px}.grid{grid-template-columns:repeat(2,1fr)}.product-img{height:290px}.banner{grid-template-columns:1fr}.banner-img{display:none}.categories{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.nav{height:68px}.grid{gap:12px}.product-img{height:240px}.hero h1{font-size:48px}.hero{min-height:auto}.section{padding:50px 0}.section h2{font-size:28px}.banner-copy{padding:30px}.newsletter{padding:40px 20px}.form button{padding:0 15px}}
</style>
</head>
